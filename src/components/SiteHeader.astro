---
import Wordmark from './Wordmark.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="home" href="/" aria-label="Canonex home"><Wordmark /></a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button button--primary cta" href="/download/">Download</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: rgb(27 25 23 / 0.9);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .home {
    text-decoration: none;
    flex-shrink: 0;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--surface-1);
  }
  nav a[aria-current='page'] {
    color: var(--brass);
  }
  .cta {
    min-height: 2.4rem;
    padding-block: 0.45rem;
  }

  /* Narrow screens: the links move to their own scrollable row. No script needed. */
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-top: 0.6rem;
    }
    .cta {
      margin-left: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0.25rem var(--gutter) 0.4rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav a {
      padding: 0.5rem 0.6rem;
      font-size: 0.9rem;
    }
    nav li:first-child a {
      padding-left: 0;
    }
  }
</style>
