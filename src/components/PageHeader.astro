---
interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <div class="lede"><slot /></div>
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: var(--step-4);
    max-width: 22ch;
  }
  .lede :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
