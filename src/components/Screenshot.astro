---
// A real app screenshot in a quiet window frame. Images are optimised to WebP at build time.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  title?: string;
  /** Eager-load the hero image; everything else loads lazily. */
  priority?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  title = 'Canonex',
  priority = false,
  sizes = '(min-width: 1180px) 1100px, 100vw',
} = Astro.props;
---

<figure class="shot">
  <div class="frame">
    <div class="chrome" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="title">{title}</span>
    </div>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes={sizes}
      format="webp"
      quality={82}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
  }
  .frame {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-0);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 30px 60px -30px rgb(0 0 0 / 0.85),
      0 0 0 6px rgb(201 164 92 / 0.04);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 1.9rem;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-1);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .title {
    color: var(--ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  img {
    width: 100%;
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }
</style>
