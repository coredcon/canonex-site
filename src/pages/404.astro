---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="section">
    <div class="wrap not-found">
      <p class="kicker">404</p>
      <h1>This record isn’t in the Codex.</h1>
      <p class="lede">The page you were looking for has moved or never existed.</p>
      <div class="button-row">
        <a class="button button--primary" href="/">Back to the homepage</a>
        <a class="button" href="/docs/">Browse the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
  }
  h1 {
    font-size: var(--step-4);
  }
  .lede {
    margin-bottom: 2rem;
  }
</style>
