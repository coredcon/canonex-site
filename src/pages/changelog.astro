---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const rendered = await Promise.all(entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })));
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title="Changelog" description="What has changed in Canonex, newest first.">
  <PageHeader kicker="Changelog" title="What’s new in Canonex">
    <p>
      Canonex is in closed beta, so these entries follow the development and beta builds. Once public builds exist,
      each release will be listed here with its version.
    </p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <ol class="entries">
        {
          rendered.map(({ entry, Content }) => (
            <li class="entry" id={entry.id}>
              <div class="when">
                <time datetime={iso(entry.data.date)}>{fmt.format(entry.data.date)}</time>
                <span class="version">{entry.data.version}</span>
              </div>
              <article>
                <h2>
                  <a href={`#${entry.id}`}>{entry.data.title}</a>
                </h2>
                <p class="summary">{entry.data.summary}</p>
                <div class="prose">
                  <Content />
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .entry:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .when {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.4rem;
  }
  time {
    color: var(--ink);
    font-weight: 550;
  }
  .version {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: 0.4rem;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--brass);
  }
  .summary {
    color: var(--ink);
    font-size: var(--step-1);
    max-width: var(--measure);
  }
  @media (max-width: 700px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    .when {
      flex-direction: row;
      gap: 0.75rem;
      align-items: baseline;
    }
  }
</style>
