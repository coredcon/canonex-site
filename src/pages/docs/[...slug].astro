---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDocTree, docHref, type Doc } from '../../data/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

interface Props {
  doc: Doc;
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const tree = await getDocTree();
const flat = tree.flatMap((g) => g.docs);
const index = flat.findIndex((d) => d.id === doc.id);
const prev = index > 0 ? flat[index - 1] : undefined;
const next = index < flat.length - 1 ? flat[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={doc.data.title} description={doc.data.description}>
  <div class="wrap docs">
    <nav class="sidebar" aria-label="Documentation">
      <a class="all" href="/docs/">All docs</a>
      {
        tree.map((g) => (
          <div class="group">
            <p class="group-title">{g.section}</p>
            <ul>
              {g.docs.map((d) => (
                <li>
                  <a href={docHref(d)} aria-current={d.id === doc.id ? 'page' : undefined}>
                    {d.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <article class="article">
      <header>
        <p class="kicker">{doc.data.section}</p>
        <h1>{doc.data.title}</h1>
        <p class="lede">{doc.data.description}</p>
      </header>

      {
        toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="group-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="Previous and next">
        {
          prev ? (
            <a class="panel" href={docHref(prev)} rel="prev">
              <span class="muted">Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="panel next" href={docHref(next)} rel="next">
              <span class="muted">Next</span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding-block: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .sidebar {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    font-size: 0.925rem;
  }
  .all {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }
  .group {
    margin-bottom: 1.5rem;
  }
  .group-title {
    margin: 0 0 0.5rem;
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sidebar ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--border);
  }
  .sidebar a:not(.all) {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .sidebar a:not(.all):hover {
    color: var(--ink);
    border-left-color: var(--border-strong);
  }
  .sidebar a[aria-current='page'] {
    color: var(--brass);
    border-left-color: var(--brass);
  }

  .article header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .article h1 {
    font-size: var(--step-4);
  }
  .article .lede {
    margin-bottom: 0;
  }
  .toc {
    margin-bottom: 2rem;
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: var(--measure);
    margin-top: 3.5rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  .pager a:hover {
    border-color: var(--brass-dim);
  }
  .pager span.muted {
    font-size: 0.8rem;
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      position: static;
      max-height: none;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .group {
      margin-bottom: 1rem;
    }
  }
</style>
